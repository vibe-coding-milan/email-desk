Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
 Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "no-referrer"
 Header always set Cache-Control "private, no-store"
 Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
